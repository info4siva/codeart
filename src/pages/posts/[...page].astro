---
import Base from '../../layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';
import {IFrontmatter} from "../../types/IFrontMatter";
import type { MarkdownInstance } from 'astro';
import { Section, PaginationHeader } from "@/components";
import { CTA } from "../../partials/CTA";
import {BlogCard} from "../../components";

const postModules = import.meta.glob('../posts/*.mdx', { eager: true }) as Record<
  string,
  MarkdownInstance<IFrontmatter>
>;
const allPosts = Object.values(postModules);
const sortedPosts = sortByDate(allPosts);
const lastThreePosts = sortedPosts.slice(0, 3);

const titleSuffix = ` - ${AppConfig.site_name}`;
const title = titleSuffix;
const description =
  'Blog Pagination';
console.log(lastThreePosts);
---

<Base head={{ title, description }}>
  <Section>
    <PaginationHeader
      title='Random title here'
      description='Lorem ipsum dolor sit amet, consectetur adipiscing elit.'
    />
  </Section>

  <Section>
    <div className="grid grid-cols-1 gap-6 md:grid-cols-3">
      {lastThreePosts.map((elt) => (
          <BlogCard key={elt.url} instance={elt} />
      ))}
    </div>
  </Section>

  <CTA />
</Base>
